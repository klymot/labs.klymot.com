      background: var(--accent, #d4a855);
      color: var(--bg, #0a1628);
      font-size: 0.62rem;
      font-weight: 700;
      opacity: 0;
      transform: scale(0.6);
      transition: opacity 0.15s ease, transform 0.15s ease;
    }
    .wind-btn.active .wind-check { opacity: 1; transform: scale(1); }
    @media (prefers-reduced-motion: reduce) {
      .wind-check { transition: none; transform: none; }
    }
    .wind-btn.active {
      border-color: var(--accent, #d4a855);
      background: color-mix(in srgb, var(--accent, #d4a855) 14%, transparent);
    }
    .wind-btn-name { font-size: 0.85rem; }
    .wind-detail { font-size: 0.72rem; color: var(--text-secondary, #888); }
    .advanced-label { font-size: 0.9rem; }

    .cart-empty { margin: 0; color: var(--text-secondary, #888); }
    .visually-hidden {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
    .ship-order-card { padding: 1rem 1.25rem; margin-top: 1rem; }
    .rating-table-card { padding: 1rem 1.25rem; margin-top: 1.25rem; }
    .ship-order-title { margin: 0 0 0.5rem; font-size: 1rem; }
    .cart-count { margin: 0.6rem 0 0; font-size: 0.85rem; color: var(--text-secondary, #888); }
    .day-controls { margin-top: 1rem; }
    .location-select {
      min-height: 44px;
      padding: 0.4rem 0.6rem;
      border-radius: 8px;
      border: 1px solid var(--border, rgba(128,128,128,0.4));
      background: var(--bg-elevated, transparent);
      color: var(--text-primary, inherit);
      font-size: 0.95rem;
    }
    .weather-row { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; }
    .receipt-card {
      padding: 1.25rem;
      font-family: var(--font-mono, monospace);
      background: var(--bg-elevated, rgba(128,128,128,0.04));
    }
    .receipt-head {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
      border-bottom: 1px dashed var(--border, rgba(128,128,128,0.4));
