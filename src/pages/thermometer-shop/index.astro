    .receipt-title { letter-spacing: 0.25em; font-size: 0.85rem; }
    .receipt-meta { font-size: 0.78rem; color: var(--text-secondary, #888); white-space: pre-line; }
    .receipt-table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }
    .receipt-table {
      border-collapse: collapse;
      width: 100%;
      min-width: 520px;
      font-size: 0.85rem;
    }
    .receipt-table th, .receipt-table td {
      text-align: left;
      padding: 0.4rem 0.6rem;
      border-bottom: 1px solid var(--border, rgba(128,128,128,0.2));
      white-space: nowrap;
    }
    .receipt-table thead th { color: var(--text-secondary, #888); }
    .receipt-item-era { color: var(--text-secondary, #888); font-size: 0.78rem; }
    .receipt-truth-row th, .receipt-truth-row td {
      border-top: 2px solid var(--border, rgba(128,128,128,0.45));
      font-weight: 600;
    }
    .receipt-truth-dash { color: var(--text-secondary, #888); }
    .receipt-footer {
      margin: 0.8rem 0 0;
      text-align: center;
      font-size: 0.75rem;
      letter-spacing: 0.12em;
      color: var(--text-secondary, #888);
    }
    #runHistorySection { margin-top: 1.5rem; }
    .run-history-scroll {
      margin-top: 0.75rem;
      padding: 0.5rem;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }
    .run-history-table {
      border-collapse: collapse;
      width: 100%;
      min-width: 640px;
      font-size: 0.85rem;
    }
    .run-history-table th, .run-history-table td {
      padding: 0.45rem 0.6rem;
      text-align: left;
      border-bottom: 1px solid var(--border, rgba(128,128,128,0.25));
      vertical-align: top;
    }
    .run-history-table th { color: var(--text-secondary, #888); font-weight: 600; }
    .run-history-items { white-space: pre-line; font-family: var(--font-mono, monospace); font-size: 0.78rem; }
    .chart-caption {
      font-size: 0.8rem;
      color: var(--text-secondary, #888);
      margin: 0.5rem 0 0;
    }
  </style>

  <style is:global>
    @media print {
      .site-header { position: static !important; }
    }

    /* Rules for elements built at runtime (order rows, receipt rows, run
       history, trash buttons) must be global: Astro's scoped styles only
       match elements present in the template at build time. Everything is
       namespaced under the page's body class so nothing leaks site-wide. */
    .lab-thermometer-shop .order-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.9rem;
    }
    .lab-thermometer-shop .order-table th,
    .lab-thermometer-shop .order-table td {
      text-align: left;
      padding: 0.25rem 0.5rem 0.25rem 0;
      border-bottom: 1px solid var(--border, rgba(128,128,128,0.25));
    }
    .lab-thermometer-shop .order-table thead th {
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--text-secondary, #888);
    }
    .lab-thermometer-shop .order-table-shelter { color: var(--text-secondary, #999); white-space: nowrap; }
    .lab-thermometer-shop .air-stats-table th[scope='row'] {
      font-weight: 400;
      color: var(--text-secondary, #999);
    }
    .lab-thermometer-shop .air-stats-table td { font-family: var(--font-mono, monospace); }
    .lab-thermometer-shop .order-table th.order-table-actions,
    .lab-thermometer-shop .order-table td.order-table-actions { text-align: right; width: 44px; padding-right: 0; }
    .lab-thermometer-shop .trash-btn {
      /* Full 44px touch target, visually compact: the negative margin lets
         the row stay tight while the hit area stays accessible. */
      min-height: 44px;
      min-width: 44px;
      margin: -8px 0;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: none;
      border: none;
      border-radius: 8px;
      color: var(--text-secondary, #999);
      cursor: pointer;
    }
    .lab-thermometer-shop .trash-btn:hover { color: var(--danger, #d06060); }
    .lab-thermometer-shop .receipt-table th,
    .lab-thermometer-shop .receipt-table td {
      text-align: left;
      padding: 0.4rem 0.6rem;
      border-bottom: 1px solid var(--border, rgba(128,128,128,0.2));
      white-space: nowrap;
    }
    .lab-thermometer-shop .receipt-table thead th { color: var(--text-secondary, #888); }
    .lab-thermometer-shop .receipt-item-era { color: var(--text-secondary, #888); font-size: 0.78rem; }
    .lab-thermometer-shop .run-history-table th,
    .lab-thermometer-shop .run-history-table td {
      padding: 0.45rem 0.6rem;
      text-align: left;
      border-bottom: 1px solid var(--border, rgba(128,128,128,0.25));
      vertical-align: top;
    }
    .lab-thermometer-shop .run-history-table th { color: var(--text-secondary, #888); font-weight: 600; }
    .lab-thermometer-shop .run-history-items { white-space: pre-line; font-family: var(--font-mono, monospace); font-size: 0.78rem; }
  </style>

  <script>
    import {
      runCheckout,
      getInstrument,
      getExposure,
      getWindRegime,
      LOCATIONS,
      EXPOSURES,
      WIND_REGIMES,
      CATALOGUE,
    } from '../../lib/thermometer-shop-model.js';
    import { clamp, cssVar } from '../../lib/lab-utils.js';
    import { sendFeatureBeacon } from '../../lib/analytics.js';

    sendFeatureBeacon('labs/thermometer-shop/00-visited');

    const MAX_ITEMS = 4;
    const MIN_ITEMS = 2;

    const els = {
      shopGrid: document.getElementById('shopGrid'),
      cartLines: document.getElementById('cartLines'),
      cartEmpty: document.getElementById('cartEmpty'),
      cartCount: document.getElementById('cartCount'),
      locationSelect: document.getElementById('locationSelect'),
      shipMonth: document.getElementById('shipMonth'),
      shipDay: document.getElementById('shipDay'),
      weatherSeedLabel: document.getElementById('weatherSeedLabel'),
      rerollWeather: document.getElementById('rerollWeather'),
      cartBar: document.getElementById('cartBar'),
      cartBarCount: document.getElementById('cartBarCount'),
      editCartBtn: document.getElementById('editCartBtn'),
      checkoutBtn: document.getElementById('checkoutBtn'),
      cartModal: document.getElementById('cartModal'),
      cartModalClose: document.getElementById('cartModalClose'),
      shippingSection: document.getElementById('shipping'),
      shipSummary: document.getElementById('shipSummary'),
      shipOrderBody: document.getElementById('shipOrderBody'),
      cartTable: document.getElementById('cartTable'),
      deliverBtn: document.getElementById('deliverBtn'),
      deliverHint: document.getElementById('deliverHint'),
      trackingSection: document.getElementById('tracking'),
      viewReceiptBtn: document.getElementById('viewReceiptBtn'),
      viewReceiptHint: document.getElementById('viewReceiptHint'),
      productDrawer: document.getElementById('productDrawer'),
      drawerKind: document.getElementById('drawerKind'),
      drawerName: document.getElementById('drawerName'),
      drawerEra: document.getElementById('drawerEra'),
      drawerIllust: document.getElementById('drawerIllust'),
      drawerBlurb: document.getElementById('drawerBlurb'),
      drawerSpecs: document.getElementById('drawerSpecs'),
      drawerCitation: document.getElementById('drawerCitation'),
      drawerExposures: document.getElementById('drawerExposures'),
      drawerAdd: document.getElementById('drawerAdd'),
      drawerHint: document.getElementById('drawerHint'),
      drawerClose: document.getElementById('drawerClose'),
      receiptSection: document.getElementById('receipt'),
      receiptMeta: document.getElementById('receiptMeta'),
      receiptBody: document.getElementById('receiptBody'),
      receiptFoot: document.getElementById('receiptFoot'),
      receiptTrueMean: document.getElementById('receiptTrueMean'),
      dayChart: document.getElementById('dayChart'),
      dayChartLegend: document.getElementById('dayChartLegend'),
      hourlyHead: document.getElementById('hourlyHead'),
      hourlyBody: document.getElementById('hourlyBody'),
      truthPromptRow: document.getElementById('truthPromptRow'),
      revealTruth: document.getElementById('revealTruth'),
      truthChart: document.getElementById('truthChart'),
      truthChartLegend: document.getElementById('truthChartLegend'),
      truthSection: document.getElementById('truth'),
      truthMedian: document.getElementById('truthMedian'),
      ratingBody: document.getElementById('ratingBody'),
      truthMean: document.getElementById('truthMean'),
      truthMax: document.getElementById('truthMax'),
      truthMin: document.getElementById('truthMin'),
      runHistorySection: document.getElementById('runHistorySection'),
      runHistoryPlaceholder: document.getElementById('runHistoryPlaceholder'),
      runHistoryContent: document.getElementById('runHistoryContent'),
      runHistoryBody: document.getElementById('runHistoryBody'),
    };

    const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
    function dayOfYearLabel(doy) {
      // Non-leap civil calendar, purely for display.
      const d = new Date(Date.UTC(2001, 0, Number(doy)));
      return `${d.getUTCDate()} ${MONTHS[d.getUTCMonth()]}`;
    }
    // Trim trailing zeros so a 0.5 °C-resolution reading shows as "12.5",
    // not a false-precision "12.50".
    function fmtC(v) {
      return String(Math.round(v * 1000) / 1000);
    }
    // Signed difference, always showing the sign (a "+0.00" is meaningful).
    function fmtSigned(v) {
      const r = Math.round(v * 100) / 100;
      return `${r >= 0 ? '+' : '−'}${Math.abs(r).toFixed(2)}`;
    }

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const scrollBehavior = prefersReducedMotion ? 'auto' : 'smooth';

    // ── Randomised presentation (never stored in the URL) ────────────
    // Product card order is shuffled every visit; the three shelter
    // buttons get one shuffled order applied identically to every card.
    function shuffle(arr) {
      const a = [...arr];
      for (let i = a.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [a[i], a[j]] = [a[j], a[i]];
      }
      return a;
    }
    shuffle([...els.shopGrid.children]).forEach((card) => els.shopGrid.appendChild(card));
    // The "Sort by: Random" dropdown doubles as the random-order
    // disclosure, dressed as the shop control people already know. Its one
    // option is Random; choosing it deals the catalogue again and closes
    // the menu.
    {
      const sortBtn = document.getElementById('sortBtn');
      const sortMenu = document.getElementById('sortMenu');
      function closeSortMenu() {
        sortMenu.hidden = true;
        sortBtn.setAttribute('aria-expanded', 'false');
      }
      sortBtn.addEventListener('click', () => {
        const opening = sortMenu.hidden;
        sortMenu.hidden = !opening;
        sortBtn.setAttribute('aria-expanded', String(opening));
      });
      document.getElementById('sortRandom').addEventListener('click', () => {
        shuffle([...els.shopGrid.children]).forEach((card) => els.shopGrid.appendChild(card));
        closeSortMenu();
        sortBtn.focus();
      });
      document.addEventListener('click', (e) => {
        if (!sortMenu.hidden && !e.target.closest('.sort-dd')) closeSortMenu();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !sortMenu.hidden) {
          closeSortMenu();
          sortBtn.focus();
        }
      });
    }
    const exposureOrder = shuffle(EXPOSURES.map((e) => e.id));
    exposureOrder.forEach((id) => {
      const card = els.drawerExposures.querySelector(`[data-exposure-id="${id}"]`);
      if (card) els.drawerExposures.appendChild(card);
    });

    // ── State ─────────────────────────────────────────────────────────
    let cart = []; // [{instrumentId, exposureId}]
    let hasCheckedOut = false; // reached the shipping screen at least once
    let hasRunOnce = false; // a delivery has been simulated
    let hasRevealedTruth = false;

    // ── Screens: the SPA "pages" of the shop flow ─────────────────────
    // One stage visible at a time (intro → shop → shipping → tracking →
    // receipt), the way people expect a cart to move between screens.
    // Data Sources stays outside the screen system, reachable everywhere.
    let currentScreen = 'intro';
    const SCREEN_GUARDS = {
      intro: () => true,
      shop: () => true,
      shipping: () => cart.length >= MIN_ITEMS,
      tracking: () => hasRunOnce,
      receipt: () => hasRunOnce,
      rating: () => hasRunOnce && hasRevealedTruth,
    };
    function refreshScreens() {
      const hero = document.getElementById('introHero');
      const model = document.getElementById('model');
      const shop = document.getElementById('shop');
      hero.hidden = currentScreen !== 'intro';
      model.hidden = currentScreen !== 'intro';
      shop.hidden = currentScreen !== 'shop';
      els.shippingSection.hidden = currentScreen !== 'shipping';
      els.trackingSection.hidden = currentScreen !== 'tracking';
      els.receiptSection.hidden = currentScreen !== 'receipt';
      els.truthSection.hidden = currentScreen !== 'rating';
      const sources = document.getElementById('sources');
      sources.hidden = currentScreen !== 'intro';
      // The cart bar follows the cart, not the screen: it appears with the
      // first item and stays through back-navigation on the browsing
      // screens, retiring on the post-checkout screens.
      const barVisible =
        cart.length >= 1 && (currentScreen === 'intro' || currentScreen === 'shop');
      els.cartBar.hidden = !barVisible;
      document.body.classList.toggle('cart-bar-visible', barVisible);
    }
    function showScreen(id, { scroll = true, push = true } = {}) {
      if (!SCREEN_GUARDS[id] || !SCREEN_GUARDS[id]()) return;
      currentScreen = id;
      refreshScreens();
      // Re-trigger the entry animation on the now-visible stage.
      document.querySelectorAll('.lab-section:not([hidden]), #introHero:not([hidden])').forEach((el) => {
        el.classList.remove('screen-in');
        void el.offsetWidth;
        el.classList.add('screen-in');
      });
      // Canvases render at 0×0 while their screen is hidden — redraw all
      // charts now that visibility has changed.
      chartRedraws.forEach((fn) => fn());
      if (scroll) window.scrollTo({ top: 0, behavior: scrollBehavior });
      if (push) pushStateToUrl();
    }
    let lastOrder = null; // { day, results, settings }
    const runHistory = [];
    // Every live chart registers its redraw here; resize and theme changes
    // re-invoke them all.
    const chartRedraws = [];
    window.addEventListener('resize', () => chartRedraws.forEach((fn) => fn()));

    // ── URL state (versioned) ─────────────────────────────────────────
    const URL_STATE_VERSION = '1';
    function readStateFromUrl() {
      const hash = location.hash.slice(1);
      if (!hash) return null;
      const params = new URLSearchParams(hash);
      if (params.get('v') !== URL_STATE_VERSION) return null;
      return {
        items: params.get('items'),
        loc: params.get('loc'),
        doy: params.get('doy'),
        cloud: params.get('cl'),
        wind: params.get('wd'),
        seed: params.get('wx'),
        unitSeed: params.get('mfg'),
        sec: params.get('sec'),
      };
    }
    function pushStateToUrl() {
      const params = new URLSearchParams();
      params.set('v', URL_STATE_VERSION);
      if (cart.length) params.set('items', cart.map((i) => `${i.instrumentId}.${i.exposureId}`).join('~'));
      params.set('loc', els.locationSelect.value);
      params.set('doy', String(dayOfYear));
      params.set('cl', String(cloudPct));
      params.set('wd', windId);
      params.set('wx', String(weatherSeed));
      params.set('mfg', String(unitSeed));
      params.set('sec', currentScreen);
      const hash = '#' + params.toString();
      if (location.hash !== hash) history.replaceState(null, '', hash);
    }

    // ── Delivery controls ─────────────────────────────────────────────
    let weatherSeed = 1 + Math.floor(Math.random() * 999999999);
    // The manufacturing seed is separate from the weather seed on purpose:
    // "New weather, same settings" must not silently hand the reader
    // newly-manufactured units, or sky variability and unit variability
    // would be indistinguishable. Fixed per visit, carried in the URL.
    let unitSeed = 1 + Math.floor(Math.random() * 999999999);
    let windId = 'moderate';
    let cloudPct = 50; // one of 0/25/50/75/100
    // Day-of-year is the model input; the yearless month/day selects are
    // its face (a generic non-leap calendar: 365 days).
    let dayOfYear = 180;

    const MONTH_DAYS = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
    const MONTH_FULL = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
    const MONTH_START = MONTH_DAYS.reduce((acc, d, i) => { acc.push((acc[i - 1] ?? 1) + (i ? MONTH_DAYS[i - 1] : 0)); return acc; }, []);
    function doyToMonthDay(doy) {
      let m = 0;
      while (m < 11 && doy >= MONTH_START[m + 1]) m++;
      return { month: m, dayOfMonth: doy - MONTH_START[m] + 1 };
    }
    function monthDayToDoy(month, dayOfMonth) {
      return MONTH_START[month] + dayOfMonth - 1;
    }
    MONTH_FULL.forEach((name, i) => {
      els.shipMonth.insertAdjacentHTML('beforeend', `<option value="${i}">${name}</option>`);
    });
    function syncDayOptions(month, selectedDay) {
      els.shipDay.innerHTML = '';
      for (let d = 1; d <= MONTH_DAYS[month]; d++) {
        els.shipDay.insertAdjacentHTML('beforeend', `<option value="${d}">${d}</option>`);
      }
      els.shipDay.value = String(Math.min(selectedDay, MONTH_DAYS[month]));
    }

    function refreshControlReadouts() {
      const { month, dayOfMonth } = doyToMonthDay(dayOfYear);
      els.shipMonth.value = String(month);
      syncDayOptions(month, dayOfMonth);
      els.weatherSeedLabel.textContent = `#${weatherSeed}`;
      document.querySelectorAll('[data-wind-id]').forEach((btn) => {
        btn.classList.toggle('active', btn.getAttribute('data-wind-id') === windId);
      });
      document.querySelectorAll('[data-cloud]').forEach((btn) => {
        btn.classList.toggle('active', Number(btn.getAttribute('data-cloud')) === cloudPct);
      });
    }

    // Two phases share this: during shopping it drives the sticky bar;
    // after checkout it drives the Deliver button.
    function markOrderChanged() {
      const enough = cart.length >= MIN_ITEMS;
      els.checkoutBtn.disabled = !enough;
      els.cartBarCount.textContent =
        cart.length === 0
          ? 'Cart is empty — 2 to 4 items to check out'
          : `${cart.length} of ${MAX_ITEMS} items${enough ? '' : ` — add ${MIN_ITEMS - cart.length} more`}`;
      els.shipSummary.textContent = `${cart.length} item${cart.length === 1 ? '' : 's'} in this order.`;
      els.deliverBtn.disabled = !enough;
      if (!enough) {
        els.deliverHint.textContent = `At least ${MIN_ITEMS} items are needed — go back to the catalogue to add more.`;
      } else if (hasRunOnce) {
        els.deliverHint.textContent = 'Order or delivery details changed — dispatch again to run the new day.';
        els.deliverBtn.disabled = false;
      } else {
        els.deliverHint.textContent = 'Sends your instruments out into the simulated day.';
      }
      // Cart-bar visibility depends on the cart count.
      if (typeof refreshScreens === 'function') refreshScreens();
    }

    const restored = readStateFromUrl();
    if (restored) {
      if (restored.loc && LOCATIONS.some((l) => l.id === restored.loc)) els.locationSelect.value = restored.loc;
      if (restored.doy) dayOfYear = clamp(Math.round(Number(restored.doy)) || 180, 1, 365);
      // Older links may carry any 0–100 value; snap to the nearest button.
      if (restored.cloud !== null) cloudPct = clamp(Math.round(Number(restored.cloud) / 25) * 25, 0, 100);
      if (restored.wind && getWindRegime(restored.wind)) windId = restored.wind;
      if (restored.seed && Number(restored.seed) > 0) weatherSeed = Math.floor(Number(restored.seed));
      if (restored.unitSeed && Number(restored.unitSeed) > 0) unitSeed = Math.floor(Number(restored.unitSeed));
      if (restored.items) {
        restored.items.split('~').slice(0, MAX_ITEMS).forEach((pair) => {
          const [instrumentId, exposureId] = pair.split('.');
          if (getInstrument(instrumentId) && getExposure(exposureId)) cart.push({ instrumentId, exposureId });
        });
      }
    } else {
      // Fresh visit: the delivery controls start at random values (stated
      // on the page), so no location, season, sky, or wind is the default.
      els.locationSelect.value = LOCATIONS[Math.floor(Math.random() * LOCATIONS.length)].id;
      dayOfYear = 1 + Math.floor(Math.random() * 365);
      cloudPct = 25 * Math.floor(Math.random() * 5);
      windId = WIND_REGIMES[Math.floor(Math.random() * WIND_REGIMES.length)].id;
    }

    function onShipDateChange() {
      const month = clamp(Number(els.shipMonth.value) || 0, 0, 11);
      const dayOfMonth = clamp(Number(els.shipDay.value) || 1, 1, MONTH_DAYS[month]);
      dayOfYear = clamp(monthDayToDoy(month, dayOfMonth), 1, 365);
      refreshControlReadouts();
      pushStateToUrl();
      markOrderChanged();
    }
    els.shipMonth.addEventListener('change', onShipDateChange);
    els.shipDay.addEventListener('change', onShipDateChange);
    els.locationSelect.addEventListener('input', () => {
      refreshControlReadouts();
      pushStateToUrl();
      markOrderChanged();
    });
    document.querySelectorAll('[data-wind-id]').forEach((btn) => {
      btn.addEventListener('click', () => {
        windId = btn.getAttribute('data-wind-id');
        refreshControlReadouts();
        pushStateToUrl();
        markOrderChanged();
      });
    });
    document.querySelectorAll('[data-cloud]').forEach((btn) => {
      btn.addEventListener('click', () => {
        cloudPct = Number(btn.getAttribute('data-cloud'));
        refreshControlReadouts();
        pushStateToUrl();
        markOrderChanged();
      });
    });
    els.rerollWeather.addEventListener('click', () => {
      weatherSeed = 1 + Math.floor(Math.random() * 999999999);
      refreshControlReadouts();
      pushStateToUrl();
      markOrderChanged();
    });

    // ── Product drawer ────────────────────────────────────────────────
    let drawerInstrumentId = null;
    let drawerExposureId = null;

    function openDrawer(card) {
      if (els.productDrawer.open) return;
      const inst = getInstrument(card.getAttribute('data-instrument-id'));
      if (!inst) return;
      drawerInstrumentId = inst.id;
      drawerExposureId = null;
      els.drawerKind.textContent = inst.kind;
      els.drawerName.textContent = inst.name;
      els.drawerEra.textContent = inst.era;
      els.drawerBlurb.textContent = inst.blurb;
      els.drawerSpecs.replaceChildren(
        ...inst.specs.flatMap((s) => {
          const dt = document.createElement('dt');
          dt.textContent = s.label;
          const dd = document.createElement('dd');
          dd.textContent = s.value;
          return [dt, dd];
        })
      );
      els.drawerCitation.textContent = `Specs: ${inst.citation}`;
      const svg = card.querySelector('.product-illust svg');
      els.drawerIllust.replaceChildren(svg ? svg.cloneNode(true) : '');
      els.drawerExposures.querySelectorAll('.exposure-card').forEach((b) => {
        b.classList.remove('active');
        b.setAttribute('aria-pressed', 'false');
      });
      const full = cart.length >= MAX_ITEMS;
      // Add to cart stays hidden (not merely disabled) until a shelter is
      // chosen — the choice is what completes the product.
      els.drawerAdd.hidden = true;
      els.drawerAdd.disabled = false;
      els.drawerHint.textContent = full ? 'Cart is full (4 items) — remove something first.' : '';
      els.productDrawer.showModal();
    }

    document.querySelectorAll('.product-card').forEach((card) => {
      card.addEventListener('click', () => openDrawer(card));
    });
    els.drawerExposures.querySelectorAll('.exposure-card').forEach((btn) => {
      btn.addEventListener('click', () => {
        drawerExposureId = btn.getAttribute('data-exposure-id');
        els.drawerExposures.querySelectorAll('.exposure-card').forEach((b) => {
          b.classList.toggle('active', b === btn);
          b.setAttribute('aria-pressed', String(b === btn));
        });
        if (cart.length < MAX_ITEMS) {
          els.drawerAdd.hidden = false;
          els.drawerHint.textContent = '';
        }
      });
    });
    els.drawerAdd.addEventListener('click', () => {
      if (!drawerInstrumentId || !drawerExposureId || cart.length >= MAX_ITEMS) return;
      cart.push({ instrumentId: drawerInstrumentId, exposureId: drawerExposureId });
      renderCart();
      pushStateToUrl();
      markOrderChanged();
      els.drawerHint.textContent = '✓ Added to cart.';
      els.drawerAdd.disabled = true;
      setTimeout(() => els.productDrawer.close(), 600);
    });
    els.drawerClose.addEventListener('click', () => els.productDrawer.close());
    els.productDrawer.addEventListener('click', (e) => {
      if (e.target === els.productDrawer) els.productDrawer.close();
    });

    // ── Cart modal ────────────────────────────────────────────────────
    function openCartModal() {
      renderCart();
      els.cartModal.showModal();
    }
    els.editCartBtn.addEventListener('click', openCartModal);
    els.cartModalClose.addEventListener('click', () => els.cartModal.close());
    els.cartModal.addEventListener('click', (e) => {
      if (e.target === els.cartModal) els.cartModal.close();
    });

    const TRASH_SVG =
      '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M3.5 6h17M9.5 6V4.5h5V6M18.5 6l-1 14.5h-11L5.5 6M10 10.5v6.5M14 10.5v6.5"/></svg>';

    // One order, two tables (the cart modal and the dispatch screen's order
    // card) — both rendered from the same rows: item, shelter, trash.
    function buildOrderRows(tbody) {
      tbody.innerHTML = '';
      cart.forEach((item, idx) => {
        const inst = getInstrument(item.instrumentId);
        const exp = getExposure(item.exposureId);
        const tr = document.createElement('tr');
        const tdItem = document.createElement('td');
        tdItem.textContent = inst.name;
        const tdExp = document.createElement('td');
        tdExp.className = 'order-table-shelter';
        tdExp.textContent = exp.short;
        const tdAct = document.createElement('td');
        tdAct.className = 'order-table-actions';
        const remove = document.createElement('button');
        remove.type = 'button';
        remove.className = 'trash-btn';
        remove.setAttribute('aria-label', `Remove ${inst.name} (${exp.label}) from the order`);
        remove.innerHTML = TRASH_SVG;
        remove.addEventListener('click', () => {
          cart.splice(idx, 1);
          renderCart();
          pushStateToUrl();
          markOrderChanged();
        });
        tdAct.appendChild(remove);
        tr.append(tdItem, tdExp, tdAct);
        tbody.appendChild(tr);
      });
    }

    function renderCart() {
      buildOrderRows(els.cartLines);
      buildOrderRows(els.shipOrderBody);
      els.cartEmpty.hidden = cart.length > 0;
      els.cartTable.hidden = cart.length === 0;
      els.cartCount.hidden = cart.length === 0;
      els.cartCount.textContent = `${cart.length} of ${MAX_ITEMS} items — ${cart.length < MIN_ITEMS ? `add ${MIN_ITEMS - cart.length} more to check out` : 'ready to check out'}.`;
    }

    // ── Chart ─────────────────────────────────────────────────────────
    const SERIES_COLORS = ['#d4a855', '#5b8dd9', '#66b28a', '#c96f9d'];

    // maxHour clips how far into the day the series are drawn — the
    // checkout animation sweeps it 0→24 so the traces draw themselves
    // across the day like pens; axes and day/night shading render in full
    // from the first frame.
    function drawDayChart(canvas, series, day, maxHour = 24) {
      const dpr = window.devicePixelRatio || 1;
      const w = canvas.clientWidth;
      const h = canvas.clientHeight;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      const ctx = canvas.getContext('2d');
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, w, h);
      const padL = 46, padR = 14, padT = 16, padB = 36;
      const plotW = w - padL - padR, plotH = h - padT - padB;

      let yMinF = Infinity, yMaxF = -Infinity;
      series.filter((s) => s.visible !== false).forEach((s) => {
        for (let i = 0; i < s.values.length; i++) {
          if (s.values[i] < yMinF) yMinF = s.values[i];
          if (s.values[i] > yMaxF) yMaxF = s.values[i];
        }
      });
      if (!isFinite(yMinF)) return;
      const yPad = Math.max(0.5, (yMaxF - yMinF) * 0.08);
      const yMin = yMinF - yPad, yMax = yMaxF + yPad;
      const xMin = 0, xMax = 24;
      const n = day.timeHours.length;

      const textColor = cssVar('--text-secondary') || '#888';
      const gridColor = cssVar('--border') || 'rgba(128,128,128,0.2)';
      const xToPix = (x) => padL + ((x - xMin) / (xMax - xMin)) * plotW;
      const yToPix = (y) => padT + plotH - ((y - yMin) / (yMax - yMin)) * plotH;

      // Day/night shading from the day's actual sun elevation.
      const shadeSteps = 96;
      for (let i = 0; i < shadeSteps; i++) {
        const hMid = ((i + 0.5) / shadeSteps) * 24;
        const idx = Math.min(n - 1, Math.round((hMid / 24) * n));
        const isNight = day.sunElevDeg[idx] <= 0;
        ctx.fillStyle = isNight ? 'rgba(80,110,220,0.16)' : 'rgba(255,200,80,0.10)';
        ctx.fillRect(xToPix((i / shadeSteps) * 24), padT, plotW / shadeSteps + 1, plotH);
      }

      ctx.font = '11px sans-serif';
      ctx.lineWidth = 1;
      // Y grid at nice steps.
      const targetTicks = 6;
      const rawStep = (yMax - yMin) / targetTicks || 1;
      const mag = Math.pow(10, Math.floor(Math.log10(rawStep)));
      const yStep = [1, 2, 5, 10].map((m) => m * mag).find((st) => (yMax - yMin) / st <= targetTicks) || 10 * mag;
      for (let yv = Math.ceil(yMin / yStep) * yStep; yv <= yMax + 1e-9; yv += yStep) {
        const yPix = yToPix(yv);
        ctx.strokeStyle = gridColor;
        ctx.beginPath(); ctx.moveTo(padL, yPix); ctx.lineTo(padL + plotW, yPix); ctx.stroke();
        ctx.fillStyle = textColor;
        ctx.fillText(String(Math.round(yv * 100) / 100), 4, yPix + 4);
      }
      ctx.fillText('°C', 4, padT - 4);
      for (let xv = 0; xv <= 24; xv += 6) {
        const px = xToPix(xv);
        ctx.strokeStyle = gridColor;
        ctx.beginPath(); ctx.moveTo(px, padT); ctx.lineTo(px, padT + plotH); ctx.stroke();
        ctx.fillStyle = textColor;
        const lbl = String(xv);
        ctx.fillText(lbl, px - ctx.measureText(lbl).width / 2, padT + plotH + 14);
      }

      // Series: decimate to ~2 points per pixel for draw speed.
      const stride = Math.max(1, Math.floor(n / (plotW * 2)));
      series.filter((s) => s.visible !== false).forEach((s) => {
        ctx.strokeStyle = s.color;
        ctx.lineWidth = s.dash ? 1.5 : 2;
        ctx.setLineDash(s.dash ? [5, 4] : []);
        ctx.beginPath();
        let started = false;
        for (let i = 0; i < n; i += stride) {
          if (day.timeHours[i] > maxHour) break;
          const px = xToPix(day.timeHours[i]);
          const py = yToPix(s.values[i]);
          if (!started) { ctx.moveTo(px, py); started = true; } else ctx.lineTo(px, py);
        }
        ctx.stroke();
      });
      ctx.setLineDash([]);
      ctx.fillStyle = textColor;
      const xTitle = 'Local solar time (hours)';
      ctx.fillText(xTitle, padL + Math.max(0, (plotW - ctx.measureText(xTitle).width) / 2), h - 6);
    }

    function createLegend(containerEl, seriesList, onToggle) {
      const offBorder = cssVar('--border') || 'rgba(255,255,255,0.28)';
      containerEl.innerHTML = '';
      containerEl.classList.add('chart-legend');
      seriesList.forEach((s) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'legend-btn';
        btn.textContent = s.label;
        function applyStyle() {
          btn.style.borderColor = s.visible !== false ? s.color : offBorder;
          btn.classList.toggle('series-off', s.visible === false);
        }
        applyStyle();
        btn.addEventListener('click', () => {
          s.visible = s.visible === false;
          applyStyle();
          onToggle();
        });
        containerEl.appendChild(btn);
      });
    }

    // ── Receipt rendering ─────────────────────────────────────────────
    function itemShortLabel(item) {
      const inst = getInstrument(item.instrumentId);
      const exp = getExposure(item.exposureId);
      return `${inst.name} · ${exp.short}`;
    }

    function renderReceipt(order) {
      const loc = LOCATIONS.find((l) => l.id === order.settings.locId);
      const wind = getWindRegime(order.settings.windId);
      els.receiptMeta.textContent =
        `Delivered to: ${loc.label}\nDay ${order.settings.doy} (${dayOfYearLabel(order.settings.doy)}) · cloud ${order.settings.cloud}% · ${wind.label.toLowerCase()} · weather #${order.settings.seed}`;
      els.receiptBody.innerHTML = '';
      order.results.forEach((r, i) => {
        const inst = getInstrument(r.instrumentId);
        const exp = getExposure(r.exposureId);
        const tr = document.createElement('tr');
        tr.innerHTML =
          `<td>${inst.name} <span class="receipt-item-era">(${inst.era})</span></td>` +
          `<td>${exp.short}</td>` +
          `<td>${fmtC(r.recordedTmaxC)}</td>` +
          `<td>${fmtC(r.recordedTminC)}</td>` +
          `<td>${fmtC(r.midpointC)}</td>`;
        tr.querySelector('td').style.borderLeft = `3px solid ${SERIES_COLORS[i]}`;
        els.receiptBody.appendChild(tr);
      });
      if (hasRevealedTruth) {
        els.receiptFoot.hidden = false;
        els.receiptTrueMean.textContent = order.day.trueMeanC.toFixed(2);
      } else {
        els.receiptFoot.hidden = true;
      }
    }

    function renderHourlyTable(order) {
      const cols = order.results.map((r) => itemShortLabel(r));
      const withAir = hasRevealedTruth;
      els.hourlyHead.innerHTML =
        '<tr><th scope="col">Hour</th>' +
        cols.map((c) => `<th scope="col">${c}</th>`).join('') +
        (withAir ? '<th scope="col">The air itself</th>' : '') +
        '</tr>';
      els.hourlyBody.innerHTML = '';
      const n = order.day.timeHours.length;
      for (let hr = 0; hr < 24; hr++) {
        const idx = Math.min(n - 1, Math.round((hr / 24) * n));
        const cells = order.results.map((r) => `<td>${r.instrSeries[idx].toFixed(2)}</td>`).join('');
        const airCell = withAir ? `<td>${order.day.airC[idx].toFixed(2)}</td>` : '';
        els.hourlyBody.insertAdjacentHTML('beforeend', `<tr><th scope="row">${String(hr).padStart(2, '0')}:00</th>${cells}${airCell}</tr>`);
      }
    }

    // The traces draw themselves across the day over a few seconds each
    // time a chart (re)renders — instant for readers who prefer reduced
    // motion. Each chart keeps its own sweep state so the tracking chart
    // and the rate-your-purchase chart animate independently.
    const CHART_SWEEP_MS = 3200;
    function createAnimatedChart(canvas, legendEl) {
      let series = [];
      let day = null;
      let maxHour = 24;
      let frame = null;
      const redraw = () => {
        if (day) drawDayChart(canvas, series, day, maxHour);
      };
      chartRedraws.push(redraw);
      return {
        render(newSeries, newDay, { animate = true, onDone = null } = {}) {
          // Preserve the reader's legend toggles across re-renders.
          newSeries.forEach((s, i) => {
            if (series[i] && series[i].label === s.label) s.visible = series[i].visible;
          });
          series = newSeries;
          day = newDay;
          createLegend(legendEl, series, redraw);
          if (frame) cancelAnimationFrame(frame);
          if (!animate || prefersReducedMotion) {
            maxHour = 24;
            redraw();
            if (onDone) onDone();
            return;
          }
          const startedAt = performance.now();
          maxHour = 0;
          const step = (now) => {
            maxHour = Math.min(24, ((now - startedAt) / CHART_SWEEP_MS) * 24);
            redraw();
            if (maxHour < 24) {
              frame = requestAnimationFrame(step);
            } else {
              frame = null;
              if (onDone) onDone();
            }
          };
          frame = requestAnimationFrame(step);
        },
      };
    }
    const trackingChart = createAnimatedChart(els.dayChart, els.dayChartLegend);
    const truthChart = createAnimatedChart(els.truthChart, els.truthChartLegend);

    function itemSeries(order) {
      return order.results.map((r, i) => ({
        label: itemShortLabel(r),
        color: SERIES_COLORS[i],
        values: r.instrSeries,
      }));
    }
    function renderChart(order) {
      // The receipt gates on the tracking sweep finishing: the traces are
      // the shipment in transit, the receipt is what arrives at the end.
      els.viewReceiptBtn.disabled = true;
      els.viewReceiptHint.textContent = 'Enables when the day finishes drawing.';
      trackingChart.render(itemSeries(order), order.day, {
        onDone: () => {
          els.viewReceiptBtn.disabled = false;
          els.viewReceiptHint.textContent = "The written record: what each item's registers actually kept from that day.";
        },
      });
    }
    function renderTruthChart(order, { animate = true } = {}) {
      truthChart.render(
        [
          ...itemSeries(order),
          {
            label: 'The air itself',
            color: cssVar('--text-primary') || '#ccc',
            values: order.day.airC,
            dash: true,
          },
        ],
        order.day,
        { animate }
      );
    }
    window.addEventListener('klymot:theme-toggled', () => chartRedraws.forEach((fn) => fn()));

    // The rating screen's numbers: air tiles plus the per-item comparison
    // of each midpoint against the air's true median and true average.
    function renderRating(order) {
      els.truthMean.textContent = `${order.day.trueMeanC.toFixed(2)} °C`;
      els.truthMedian.textContent = `${order.day.trueMedianC.toFixed(2)} °C`;
      els.truthMax.textContent = `${order.day.trueMaxC.toFixed(2)} °C`;
      els.truthMin.textContent = `${order.day.trueMinC.toFixed(2)} °C`;
      els.ratingBody.innerHTML = '';
      order.results.forEach((r, i) => {
        const inst = getInstrument(r.instrumentId);
        const exp = getExposure(r.exposureId);
        const tr = document.createElement('tr');
        tr.innerHTML =
          `<td>${inst.name}</td>` +
          `<td class="order-table-shelter">${exp.short}</td>` +
          `<td>${fmtC(r.midpointC)}</td>` +
          `<td>${fmtSigned(r.midpointC - order.day.trueMedianC)}</td>` +
          `<td>${fmtSigned(r.midpointC - order.day.trueMeanC)}</td>`;
        tr.querySelector('td').style.borderLeft = `3px solid ${SERIES_COLORS[i]}`;
        els.ratingBody.appendChild(tr);
      });
      // The rating chart is a reference view, not a reveal — no sweep.
      renderTruthChart(order, { animate: false });
    }

    function renderRunHistory() {
      els.runHistorySection.hidden = runHistory.length === 0;
      if (runHistory.length < 2) {
        els.runHistoryPlaceholder.hidden = runHistory.length === 0;
        els.runHistoryContent.hidden = true;
        return;
      }
      els.runHistoryPlaceholder.hidden = true;
      els.runHistoryContent.hidden = false;
      els.runHistoryBody.innerHTML = '';
      runHistory.forEach((run, i) => {
        const loc = LOCATIONS.find((l) => l.id === run.settings.locId);
        const itemsText = run.results
          .map((r) => `${itemShortLabel(r)}: ${fmtC(r.recordedTmaxC)} / ${fmtC(r.recordedTminC)} / ${fmtC(r.midpointC)}`)
          .join('\n');
        const truth = run.truthKnown ? run.trueMeanC.toFixed(2) : '—';
        const tr = document.createElement('tr');
        tr.innerHTML =
          `<td>${i + 1}</td>` +
          `<td>${loc.label}, day ${run.settings.doy}, cloud ${run.settings.cloud}%, ${getWindRegime(run.settings.windId).label.toLowerCase()}, weather #${run.settings.seed}</td>` +
          `<td class="run-history-items">${itemsText}</td>` +
          `<td>${truth}</td>`;
        els.runHistoryBody.appendChild(tr);
      });
    }

    // ── Screen navigation buttons ─────────────────────────────────────
    document.getElementById('browseBtn').addEventListener('click', () => showScreen('shop'));
    document.getElementById('backToIntro').addEventListener('click', () => showScreen('intro'));
    document.getElementById('backToShop').addEventListener('click', () => showScreen('shop'));
    document.getElementById('backToShipping').addEventListener('click', () => showScreen('shipping'));
    document.getElementById('backToTracking').addEventListener('click', () => showScreen('tracking'));
    document.getElementById('backToReceipt').addEventListener('click', () => showScreen('receipt'));

    els.checkoutBtn.addEventListener('click', () => {
      if (cart.length < MIN_ITEMS) return;
      if (!hasCheckedOut) {
        hasCheckedOut = true;
        sendFeatureBeacon('labs/thermometer-shop/01-checked-out');
      }
      markOrderChanged();
      showScreen('shipping');
    });

    // ── Deliver: run the day ──────────────────────────────────────────
    els.deliverBtn.addEventListener('click', () => {
      if (cart.length < MIN_ITEMS) return;
      const settings = {
        locId: els.locationSelect.value,
        doy: dayOfYear,
        cloud: cloudPct,
        windId,
        seed: weatherSeed,
      };
      const loc = LOCATIONS.find((l) => l.id === settings.locId);
      const { day, results } = runCheckout({
        latDeg: loc.latDeg,
        dayOfYear: settings.doy,
        cloudFraction: settings.cloud / 100,
        seed: settings.seed,
        unitSeed,
        windId,
        items: cart,
      });
      lastOrder = { day, results, settings };
      runHistory.push({
        settings,
        results,
        trueMeanC: day.trueMeanC,
        truthKnown: hasRevealedTruth,
      });
      // Once the truth line has been revealed once, later orders keep it —
      // the gate exists so the first look at the receipt happens before
      // the true mean is on it, not to make every re-run re-click.
      if (hasRevealedTruth) {
        runHistory.forEach((r) => { r.truthKnown = true; });
        renderRating(lastOrder);
      }
      renderReceipt(lastOrder);
      renderHourlyTable(lastOrder);
      renderChart(lastOrder);
      renderRunHistory();
      hasRunOnce = true;
      els.deliverBtn.disabled = true;
      els.deliverHint.textContent = 'Dispatched — change the order or delivery details to run another day.';
      sendFeatureBeacon('labs/thermometer-shop/02-delivered');
      // The live chart is the shipment tracking screen; the receipt is the
      // next screen, reached by its own button so the eye follows the
      // traces drawing first.
      showScreen('tracking');
    });

    els.viewReceiptBtn.addEventListener('click', () => showScreen('receipt'));

    // ── Rate your purchase: its own screen ────────────────────────────
    els.revealTruth.addEventListener('click', () => {
      if (!lastOrder) return;
      const firstReveal = !hasRevealedTruth;
      hasRevealedTruth = true;
      runHistory.forEach((r) => { r.truthKnown = true; });
      renderRating(lastOrder);
      renderReceipt(lastOrder);
      renderHourlyTable(lastOrder);
      renderRunHistory();
      if (firstReveal) sendFeatureBeacon('labs/thermometer-shop/03-true-mean-revealed');
      showScreen('rating');
    });

    // ── Init ──────────────────────────────────────────────────────────
    renderCart();
    refreshControlReadouts();
    markOrderChanged();
    // Restore the screen from a shared link, clamped to what the restored
    // state can actually reach: tracking/receipt need a run this session,
    // so they downgrade to shipping.
    if (restored && restored.sec) {
      let target = restored.sec;
      if ((target === 'tracking' || target === 'receipt' || target === 'rating') && !hasRunOnce) target = 'shipping';
      if (target === 'shipping' && cart.length < MIN_ITEMS) target = 'shop';
      if (!(target in SCREEN_GUARDS)) target = 'intro';
      if (target === 'shipping') hasCheckedOut = true;
      currentScreen = target;
    }
    refreshScreens();
    pushStateToUrl();

    // Reset lab: all state lives in the URL hash; drop it and reload.
    const resetBtn = document.getElementById('resetLab');
    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        window.location.href = window.location.pathname;
      });
    }
  </script>
</BaseLayout>
